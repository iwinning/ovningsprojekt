{
  "chat.permissions.default": "default",
  "chat.tools.terminal.enableAutoApprove": true,
  "chat.tools.terminal.ignoreDefaultAutoApproveRules": false,
  "chat.tools.terminal.autoApprove": {
    "git status": true,
    "git log": true,
    "git diff": true,
    "npm run lint": true,
    "npm run typecheck": true,
    "npm run format:check": true,
    "npm test": true,
    "/^node --test \\.github[\\\\/]hooks[\\\\/]rigg\\.spec\\.cjs$/": true,
    "npm run db:reset": false,
    "git reset --hard": false,
    "git clean": false,
    "git push": false,
    "git tag": false,
    "docker system prune": false,
    "rm": false,
    "rmdir": false,
    "del": false,
    "Remove-Item": false
  },
  "chat.tools.edits.autoApprove": {
    "**/*": true,
    "**/.env": false,
    "**/.env.*": false,
    "**/.vscode/*.json": false,
    "**/.github/hooks/**": false,
    "**/.github/workflows/**": false,
    "**/db/schema.sql": false,
    "**/db/seed.sql": false
  }
}
